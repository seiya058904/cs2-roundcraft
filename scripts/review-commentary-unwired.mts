type Review={id:string;decision:'wired'|'deferred';reason:string};
const records=new Map<string,Review>();
for(const [text,decision] of [[enabledReview,'wired'],[deferredReview,'deferred']] as const)for(const line of text.trim().split('\n')){
 const [ids,reason]=line.split('|');assert.ok(reason,line);
 for(const id of ids.trim().split(/\s+/)){assert.ok(!records.has(id),'重复审读项 '+id);records.set(id,{id,decision,reason});}
}
const baseline=JSON.parse(readFileSync('docs/commentary-integration-accountability.json','utf8'));
const rows=baseline.rows.filter((q:any)=>q.status==='unwired'&&/^(RD|RF|RW)-/.test(q.id));
const wired=new Set([...readFileSync('src/domain/realQuotes.ts','utf8').matchAll(/['"]((?:RD|RF|RW)-\d+-\d+)['"]/g)].map(m=>m[1]));
const wanted=new Set<string>(rows.map((q:any)=>q.id));
const missing=[...wanted].filter(id=>!records.has(id)),extra=[...records.keys()].filter(id=>!wanted.has(id));
assert.deepEqual({missing,extra},{missing:[],extra:[]},'每条必须有明确审读决定，不能泛化填充');
const reviewed=rows.map((q:any)=>{const record=records.get(q.id)!;assert.equal(wired.has(q.id),record.decision==='wired',q.id+' 接线与审读不符');return {text:q.text,source:q.source,sourceFile:q.sourceFile,...record};});
assert.equal(reviewed.length,345);
const report={...reportMetadata(),baselineSourceSha256:baseline.simulationSourceSha256,reviewed:345,newlyWired:reviewed.filter((q:Review)=>q.decision==='wired').length,deferred:reviewed.filter((q:Review)=>q.decision==='deferred').length,rows:reviewed};
writeFileSync('docs/commentary-quote-review-iteration9.json',JSON.stringify(report,null,2));
const escape=(s:string)=>s.replaceAll('|','\\|');
writeFileSync('docs/COMMENTARY_QUOTE_REVIEW_ITERATION9.md',`# 原未接线345条逐句审读\n\n日期：2026-10-27。以此前对账冻结的345个编号为集合；每条均保留原文、出处和单独审读决定。新增接线${report.newlyWired}条，暂不接${report.deferred}条。接线不等于已播出，实际候选与使用数另见第九轮模拟报告。暂不接表示当前证据或节拍不足，不声称永久不可能。\n\n| 编号 | 原文 | 决定 | 事实条件 / 暂不能接原因 |\n| --- | --- | --- | --- |\n`+reviewed.map((q:any)=>`| ${q.id} | ${escape(q.text)} | ${q.decision==='wired'?'已接线':'暂不接'} | ${q.reason} |`).join('\n')+'\n');
console.log({...report,rows:undefined});
