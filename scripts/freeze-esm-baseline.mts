import {createHash} from 'node:crypto';import {writeFileSync,existsSync} from 'node:fs';import {newWorld} from '../src/data/index.ts';import {createSeries,autoVeto} from '../src/domain/series.ts';import {simulateSeries} from '../src/domain/engine.ts';
if(existsSync('docs/esm-review/legacy-fingerprints.json'))throw new Error('冻结基线已存在，禁止覆盖');
const rows=[];for(const version of [undefined,'causal-2026-10-v3'])for(const seed of [1,224,732]){const s=createSeries(newWorld(),'team-3','team-7',1,seed);if(version)s.engineVersion=version;else delete s.engineVersion;autoVeto(s);simulateSeries(s);rows.push({version:version??'legacy',seed,hash:createHash('sha256').update(JSON.stringify(s)).digest('hex')});}writeFileSync('docs/esm-review/legacy-fingerprints.json',JSON.stringify(rows,null,2));
